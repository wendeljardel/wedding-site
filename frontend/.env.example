# Copie este arquivo para .env e preencha com seus valores.
# Variaveis comecadas com VITE_ ficam expostas no bundle do frontend.

# Chave Pix usada para receber as cotas de lua de mel.
# Pode ser CPF, email, telefone ou chave aleatoria (recomendado).
# Se nao for preenchida, o modal mostra uma mensagem amigavel para
# os convidados avisando que ainda nao foi configurada.
VITE_PIX_KEY=

# Nome do beneficiario que aparece no app do banco do convidado.
# Maximo 25 caracteres, ASCII (sem acentos).
VITE_PIX_MERCHANT_NAME=THAMIRES E WENDEL

# Cidade do beneficiario.
# Maximo 15 caracteres, ASCII (sem acentos).
VITE_PIX_MERCHANT_CITY=SAO PAULO

# Em dev, a lista de presentes usa mock-gifts.ts (local) por padrao.
# Defina true para testar contra a API publicada na AWS.
# VITE_USE_PROD_API=true
